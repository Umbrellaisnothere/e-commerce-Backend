# Copy this file to .env and replace the placeholder secrets.
# Do not commit .env.
#
# JWT_SECRET_KEY is required. The placeholder below is rejected at startup.
# In production (FLASK_ENV=production, or FLASK_ENV unset), it must be at
# least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET_KEY=replace-with-a-long-random-value
SECRET_KEY=replace-with-a-long-random-value

# development | production (unset is treated as production)
# Seed script requires FLASK_ENV=development. Unset/production is refused.
# FLASK_ENV=development

# Optional local seed passwords. Leave unset to generate random passwords
# (printed once). Do not put real passwords here.
# SEED_PASSWORD_ANGEL=
# SEED_PASSWORD_MITCHELLE=

# Optional. Defaults to the existing SQLite file used by the app.
# DATABASE_URL=sqlite:///../instance/products.db

# Dev server (python app.py). Debug is off unless FLASK_DEBUG=1.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
