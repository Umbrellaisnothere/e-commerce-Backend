# Copy this file to .env and replace the placeholder secrets.
# Do not commit .env.

JWT_SECRET_KEY=replace-with-a-long-random-value
SECRET_KEY=replace-with-a-long-random-value

# Optional. Defaults to the existing SQLite file used by the app.
# DATABASE_URL=sqlite:///../instance/products.db

# Dev server (python app.py). Debug is off unless FLASK_DEBUG=1.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
